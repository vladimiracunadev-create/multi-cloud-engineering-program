#!/usr/bin/env python3
"""Refresca el registro de fuentes contra la autoridad externa. Usa red.

Manual o programado. **No bloquea** y no debe entrar en el CI: la red no es
determinista, y un gate que falla por causas ajenas al cambio se acaba
ignorando. El gate es `scripts/verify-sources`, que no abre conexiones.

Que hace:
  - resuelve ISBN contra openlibrary.org comparando titulo y autores;
  - resuelve DOI contra api.crossref.org comparando titulo;
  - hace GET a cada URL de norma o documentacion y registra el estado;
  - actualiza `verified_on` y `accessed`;
  - reporta lo que dejo de resolver, sin borrarlo.

Nada se acepta por parecido vago: si el titulo devuelto no se parece al citado,
la entrada sigue 'pendiente' con el motivo. Ninguna entrada se elimina jamas.

Uso:
    python scripts/refresh-sources                    # todo
    python scripts/refresh-sources --only books       # books | papers | urls
    python scripts/refresh-sources --limit 20         # prueba corta
    python scripts/refresh-sources --dry-run
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import sys
import threading
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.stdout.reconfigure(encoding="utf-8", errors="replace")

from sources_lib import REGISTRY, ROOT, dump_registry, isbn13_ok, load_registry  # noqa: E402

UA = "multi-cloud-engineering-program/sources-refresh (+https://github.com/vladimiracunadev-create/multi-cloud-engineering-program)"
TIMEOUT = 25
PRINT_LOCK = threading.Lock()


def say(message: str) -> None:
    with PRINT_LOCK:
        print(message, flush=True)


def fetch(url: str, timeout: int = TIMEOUT) -> tuple[int, bytes]:
    request = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "*/*"})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.getcode(), response.read()
    except urllib.error.HTTPError as exc:
        return exc.code, b""
    except Exception as exc:  # noqa: BLE001 - la causa se registra tal cual
        return 0, str(exc).encode("utf-8", "replace")


def fetch_json(url: str, retries: int = 3) -> tuple[dict | None, int]:
    """Devuelve (json, codigo). El codigo importa: 429 no es 'no existe'."""
    code = 0
    for attempt in range(retries):
        code, body = fetch(url)
        if code == 200 and body:
            try:
                return json.loads(body.decode("utf-8", "replace")), code
            except json.JSONDecodeError:
                return None, code
        if code in (429, 500, 502, 503, 504) and attempt < retries - 1:
            time.sleep(2 * (attempt + 1))
            continue
        break
    return None, code


def unreachable(code: int) -> str:
    """Distingue 'no aparece en el catalogo' de 'no se pudo comprobar'."""
    if code == 200:
        return ""
    if code == 0:
        return "no se pudo comprobar (error de red)"
    return f"no se pudo comprobar (HTTP {code})"


def norm(text: str) -> str:
    text = unicodedata.normalize("NFD", text or "")
    text = "".join(c for c in text if unicodedata.category(c) != "Mn").lower()
    return re.sub(r"[^a-z0-9]+", " ", text).strip()


STOPWORDS = {"a", "an", "the", "and", "or", "of", "for", "to", "in", "on", "with", "at"}


def title_matches(cited: str, found: str) -> bool:
    """Acepta solo si es la misma obra, no una que la contenga.

    La contencion suelta no vale: 'Software Architecture' esta dentro de
    'Fundamentals of Software Architecture', que es OTRO libro. Solo se acepta
    igualdad, o que uno sea prefijo del otro en frontera de palabra, que es como
    se comporta un subtitulo.
    """
    a, b = norm(cited), norm(found)
    if not a or not b:
        return False
    if a == b or a.startswith(b + " ") or b.startswith(a + " "):
        return True
    # Misma obra con articulos distintos: "Kubernetes: Up & Running" vs
    # "Kubernetes up and running". Solo difieren palabras vacias.
    wa, wb = set(a.split()), set(b.split())
    return bool(wa) and (wa ^ wb) <= STOPWORDS and bool(wa & wb)


def author_matches(cited: list[str], found: list[str]) -> bool:
    """La autoria confirma; su ausencia en el catalogo no desmiente.

    Varias fichas de openlibrary no traen autor. Rechazar por eso marcaria
    pendiente una obra que si coincide en titulo, asi que solo se exige
    coincidencia cuando la autoridad declara autores.
    """
    if not cited or not found:
        return True
    surnames = {norm(a.split(",")[0]) for a in cited if a and norm(a.split(",")[0])}
    blob = norm(" ".join(found))
    return any(s and s in blob for s in surnames)


# --------------------------------------------------------------------------- libros


def openlibrary_isbn(entry: dict) -> tuple[str | None, str, str]:
    """ISBN-13 de la edicion mas adecuada. Devuelve (isbn13, titulo, motivo)."""
    fields = "&fields=key,title,author_name,first_publish_year"
    # Busqueda estructurada: pasar "Apellido, N." como texto libre no encuentra nada.
    params = {"title": entry["title"].split(":")[0].strip(), "limit": 5}
    if entry.get("authors"):
        params["author"] = entry["authors"][0].split(",")[0].strip()
    data, code = fetch_json(f"https://openlibrary.org/search.json?{urllib.parse.urlencode(params)}{fields}")
    if not data or not data.get("docs"):
        # Segundo intento sin autor: hay obras catalogadas con otra autoria.
        params.pop("author", None)
        data, code = fetch_json(f"https://openlibrary.org/search.json?{urllib.parse.urlencode(params)}{fields}")
    if not data or not data.get("docs"):
        return None, "", f"openlibrary: {unreachable(code) or 'el titulo no aparece en el catalogo'}"

    doc = None
    for candidate in data["docs"]:
        if title_matches(entry["title"], candidate.get("title", "")) and author_matches(
            entry.get("authors") or [], candidate.get("author_name") or []
        ):
            doc = candidate
            break
    if doc is None:
        best = data["docs"][0].get("title", "?")
        return None, best, f"openlibrary devolvio '{best}', que no coincide con el titulo citado"

    editions, code = fetch_json(f"https://openlibrary.org{doc['key']}/editions.json?limit=100")
    if not editions or not editions.get("entries"):
        return None, doc.get("title", ""), (
            f"openlibrary: {unreachable(code) or 'la obra no expone ediciones con ISBN'}"
        )

    cited_year = int(entry.get("published") or 0)
    candidates: list[tuple[int, str]] = []
    for edition in editions["entries"]:
        isbns = [i for i in (edition.get("isbn_13") or []) if isbn13_ok(i)]
        if not isbns:
            continue
        languages = {lang.get("key", "") for lang in (edition.get("languages") or [])}
        year_match = re.search(r"(\d{4})", str(edition.get("publish_date") or ""))
        year = int(year_match.group(1)) if year_match else 0
        # Se prefiere la edicion inglesa del anio citado. Una traduccion
        # declarada se descarta activamente: no es la edicion que cita la clase.
        if languages and "/languages/eng" not in languages:
            score = -5
        else:
            score = 2 if languages else 1
        if year and cited_year:
            if year == cited_year:
                score += 3
            elif abs(year - cited_year) <= 2:
                score += 1
        candidates.append((score, isbns[0]))
    if not candidates:
        return None, doc.get("title", ""), "ninguna edicion de openlibrary trae ISBN-13 valido"
    candidates.sort(key=lambda pair: -pair[0])
    return candidates[0][1], doc.get("title", ""), ""


def google_books_isbn(entry: dict) -> tuple[str | None, str, str]:
    """Segunda opinion cuando openlibrary no resuelve."""
    terms = f'intitle:"{entry["title"].split(":")[0]}"'
    if entry.get("authors"):
        terms += f' inauthor:"{entry["authors"][0].split(",")[0]}"'
    data, code = fetch_json(f"https://www.googleapis.com/books/v1/volumes?q={urllib.parse.quote(terms)}&maxResults=5")
    if not data or not data.get("items"):
        return None, "", f"google books: {unreachable(code) or 'sin resultados'}"
    for item in data["items"]:
        info = item.get("volumeInfo", {})
        if not title_matches(entry["title"], info.get("title", "")):
            continue
        if not author_matches(entry.get("authors") or [], info.get("authors") or []):
            continue
        for ident in info.get("industryIdentifiers") or []:
            if ident.get("type") == "ISBN_13" and isbn13_ok(ident.get("identifier", "")):
                return ident["identifier"], info.get("title", ""), ""
    return None, "", "google books no devolvio un ISBN-13 con titulo y autor coincidentes"


ISBN_IN_URL = re.compile(r"(97[89][0-9]{10})")


def isbn_from_url(url: str) -> str | None:
    """El enlace editorial ya trae el ISBN de la edicion citada."""
    for candidate in ISBN_IN_URL.findall(url or ""):
        if isbn13_ok(candidate):
            return candidate
    return None


def confirm_isbn(isbn: str, entry: dict) -> tuple[bool, str, str]:
    """Comprueba contra catalogo que ese ISBN es la obra citada."""
    data, code = fetch_json(f"https://openlibrary.org/isbn/{isbn}.json")
    if data and data.get("title"):
        found = data["title"]
        return title_matches(entry["title"], found), found, ""

    data, gcode = fetch_json(f"https://www.googleapis.com/books/v1/volumes?q=isbn:{isbn}")
    for item in (data or {}).get("items", []):
        found = item.get("volumeInfo", {}).get("title", "")
        if found:
            return title_matches(entry["title"], found), found, ""
    detail = unreachable(code) or unreachable(gcode) or "ningun catalogo conoce ese ISBN"
    return False, "", detail


def resolve_book(entry: dict, today: str) -> str:
    # 1) El ISBN que la propia cita lleva en su enlace editorial manda: es la
    #    edicion exacta a la que apunta la clase, no una cualquiera de la obra.
    url_isbn = isbn_from_url(entry.get("source_url") or "")
    if url_isbn:
        ok, found_title, detail = confirm_isbn(url_isbn, entry)
        if ok:
            entry["isbn13"] = url_isbn
            entry["locator"] = f"https://openlibrary.org/isbn/{url_isbn}"
            entry["verified_title"] = found_title
            entry["accessed"] = today
            entry["status"] = "verificada"
            entry["pending_reason"] = None
            return "verificada"
        entry["isbn13_candidate"] = url_isbn
        entry["isbn13_candidate_note"] = f"ISBN del enlace citado, sin confirmar: {detail or found_title}"

    # 2) Si no, se busca la obra por titulo y autor.
    isbn, found_title, reason = openlibrary_isbn(entry)
    if not isbn:
        isbn, found_title, reason2 = google_books_isbn(entry)
        if not isbn:
            entry["status"] = "pendiente"
            entry["pending_reason"] = f"ISBN-13 sin resolver: {reason}; {reason2}"
            return "pendiente"
    entry["isbn13"] = isbn
    entry["locator"] = f"https://openlibrary.org/isbn/{isbn}"
    entry["verified_title"] = found_title
    entry["accessed"] = today
    entry["status"] = "verificada"
    entry["pending_reason"] = None
    return "verificada"


# --------------------------------------------------------------------------- articulos

DOI_IN_URL = re.compile(r"(10\.\d{4,9}/[^\s?#]+)", re.I)


def doi_from_url(url: str) -> str | None:
    match = DOI_IN_URL.search(urllib.parse.unquote(url or ""))
    return match.group(1).rstrip(".").rstrip("/") if match else None


def resolve_paper(entry: dict, today: str) -> str:
    doi = entry.get("doi") or doi_from_url(entry.get("source_url") or "")
    # De donde sale el DOI cambia el listón. Si la clase ya lo cita, se esta
    # comprobando SU localizador; si hay que buscarlo, se esta eligiendo uno
    # nuevo y el titulo tiene que coincidir sin margen.
    doi_source = "url" if doi else "search"

    if not doi and "arxiv.org" in (entry.get("source_url") or ""):
        arxiv_id = re.search(r"arxiv\.org/(?:abs|pdf)/([0-9]{4}\.[0-9]{4,5})", entry["source_url"])
        if arxiv_id:
            doi = f"10.48550/arXiv.{arxiv_id.group(1)}"
            doi_source = "url"

    search_code = 200
    if not doi:
        query = urllib.parse.urlencode({"query.bibliographic": entry["title"], "rows": 3})
        data, search_code = fetch_json(f"https://api.crossref.org/works?{query}")
        for item in ((data or {}).get("message") or {}).get("items", []):
            found = (item.get("title") or [""])[0]
            if title_matches(entry["title"], found):
                doi = item.get("DOI")
                break
    if not doi:
        entry["status"] = "pendiente"
        entry["pending_reason"] = (
            f"DOI sin resolver: crossref {unreachable(search_code) or 'no devolvio un titulo coincidente'}"
        )
        return "pendiente"

    quoted = urllib.parse.quote(doi, safe="")
    data, code = fetch_json(f"https://api.crossref.org/works/{quoted}")
    message = (data or {}).get("message") or {}
    found = (message.get("title") or [""])[0]

    if not data:
        # arXiv y otros repositorios registran su DOI en DataCite, no en
        # Crossref: alli un 404 no significa que el DOI no exista.
        alt, alt_code = fetch_json(f"https://api.datacite.org/dois/{quoted}")
        attributes = ((alt or {}).get("data") or {}).get("attributes") or {}
        titles = attributes.get("titles") or []
        if titles:
            found = titles[0].get("title", "")
            data = alt
            code = alt_code
    if not data:
        entry["status"] = "pendiente"
        entry["pending_reason"] = f"DOI {doi}: no lo resuelven ni crossref ni datacite ({unreachable(code)})"
        return "pendiente"
    entry.pop("title_note", None)
    if found and not title_matches(entry["title"], found):
        if doi_source == "search":
            entry["status"] = "pendiente"
            entry["pending_reason"] = f"el DOI {doi} devuelve '{found}', que no coincide con el titulo citado"
            return "pendiente"
        # El DOI es el que cita la clase y resuelve: se acepta el localizador y
        # se deja constancia de que la autoridad lo titula de otra forma.
        entry["title_note"] = f"la autoridad lo titula '{found}'"

    entry["doi"] = doi
    entry["locator"] = f"https://doi.org/{doi}"
    entry["verified_title"] = found or entry["title"]
    entry["accessed"] = today
    entry["status"] = "verificada"
    entry["pending_reason"] = None
    return "verificada"


# --------------------------------------------------------------------------- normas y documentacion


def resolve_url(entry: dict, today: str) -> str:
    url = entry.get("locator") or entry.get("source_url")
    if not url:
        entry["status"] = "pendiente"
        entry["pending_reason"] = "la cita no trae URL"
        return "pendiente"

    code, body = fetch(url)
    entry["http_status"] = code
    if code == 200:
        entry["locator"] = url
        entry["accessed"] = today
        entry["status"] = "verificada"
        entry["pending_reason"] = None
        return "verificada"

    entry["status"] = "pendiente"
    detail = body.decode("utf-8", "replace")[:120] if code == 0 else ""
    entry["pending_reason"] = (
        f"la URL no resolvio: error de red ({detail})" if code == 0 else f"la URL respondio HTTP {code}"
    )
    return "pendiente"


# --------------------------------------------------------------------------- orquestacion


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--only", choices=["books", "papers", "urls"], help="refresca solo un tipo")
    parser.add_argument("--limit", type=int, help="corta tras N entradas (pruebas)")
    parser.add_argument("--workers", type=int, default=8)
    parser.add_argument("--force", action="store_true", help="revisa tambien lo ya verificado")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    data = load_registry(REGISTRY)
    today = dt.date.today().isoformat()

    def bucket(entry: dict) -> str:
        return {"book": "books", "paper": "papers"}.get(entry["type"], "urls")

    targets = [e for e in data["entries"] if not args.only or bucket(e) == args.only]
    if args.limit:
        targets = targets[: args.limit]

    print(f"refrescando {len(targets)} entradas de {len(data['entries'])} · fecha {today}")
    print("=" * 70)

    resolvers = {"books": resolve_book, "papers": resolve_paper, "urls": resolve_url}
    counters = {"verificada": 0, "pendiente": 0, "conservada": 0}
    lost: list[dict] = []
    kept: list[dict] = []

    def work(entry: dict) -> None:
        was_verified = entry.get("status") == "verificada" and entry.get("locator")
        if was_verified and not args.force:
            counters["conservada"] += 1
            return
        before = dict(entry)

        result = resolvers[bucket(entry)](entry, today)

        # Un 429 o un corte de red no desmienten nada. Degradar una entrada ya
        # comprobada por un fallo de transporte haria oscilar el registro y
        # convertiria el informe de huecos en ruido.
        if result == "pendiente" and was_verified and "no se pudo comprobar" in (entry.get("pending_reason") or ""):
            note = entry.get("pending_reason")
            entry.clear()
            entry.update(before)
            entry["last_check_error"] = note
            counters["conservada"] += 1
            kept.append(entry)
            say(f"  ~~ [{entry['type']:<9}] {entry['id'][:52]:<52} se conserva lo verificado: {note}"[:190])
            return

        counters[result] += 1
        if result == "pendiente" and was_verified:
            lost.append(entry)
        else:
            entry.pop("last_check_error", None)
        mark = "ok" if result == "verificada" else "--"
        say(f"  {mark} [{entry['type']:<9}] {entry['id'][:52]:<52} {entry.get('pending_reason') or ''}"[:190])

    with ThreadPoolExecutor(max_workers=args.workers) as pool:
        list(pool.map(work, targets))

    print("=" * 70)
    print(f"verificadas ahora : {counters['verificada']}")
    print(f"pendientes        : {counters['pendiente']}")
    print(f"ya verificadas    : {counters['conservada']} (usa --force para revisarlas)")

    if lost:
        print(f"\nDEJARON DE RESOLVER ({len(lost)}) — se marcan, no se borran:")
        for entry in lost:
            print(f"  ! {entry['id']}: {entry['pending_reason']}")

    total_ok = sum(1 for e in data["entries"] if e.get("status") == "verificada")
    if not args.only:
        data["verified_on"] = today
    elif total_ok:
        data["verified_on"] = data.get("verified_on") or today

    if args.dry_run:
        print("\n--dry-run: no se escribio nada")
        return 0
    dump_registry(data, REGISTRY)
    print(f"\nescrito {REGISTRY.relative_to(ROOT).as_posix()} · {total_ok} verificadas en total")
    print("Recuerda regenerar las cifras del README: python scripts/verify-sources --write")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

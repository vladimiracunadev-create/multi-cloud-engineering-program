<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.vladimiracuna.multicloud"
    android:versionCode="1"
    android:versionName="1.0.0">

  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

  <!-- Solo para abrir el manual y las referencias externas; el curso funciona sin red. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:theme="@style/AppTheme"
      android:allowBackup="true"
      android:supportsRtl="false"
      android:hardwareAccelerated="true"
      android:usesCleartextTraffic="false">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout|density"
        android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
